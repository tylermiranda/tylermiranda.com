---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const {
  title = 'Tyler Miranda | Senior Platform Engineer & AI Systems Builder',
  description = 'Senior Platform Engineer architecting enterprise digital workplace platforms, Cloud PC & identity infrastructure, and building full-stack edge AI applications, Model Context Protocol (MCP) tooling, and native Swift apps.',
  image = '/tyler_adult.jpeg',
  bodyClass = ''
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Tyler Miranda" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content="Tyler Miranda" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data for Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Tyler Miranda",
      "url": "https://tylermiranda.com",
      "image": "https://tylermiranda.com/tyler_adult.jpeg",
      "jobTitle": "Senior Platform Engineer",
      "description": "Senior Platform Engineer with 15+ years designing enterprise digital workplace systems, Cloud PC automation, and building full-stack edge AI applications and MCP infrastructure.",
      "knowsAbout": [
        "Cloudflare Workers",
        "Model Context Protocol (MCP)",
        "SwiftUI & Swift 6",
        "Docker & Containerization",
        "SQLite & FTS5 BM25",
        "Windows 365 Cloud PC",
        "Microsoft Intune & Entra ID",
        "Zero Trust Architecture",
        "PowerShell & Python"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/tyler-miranda-pro/",
        "https://github.com/tylermiranda"
      ],
      "email": "mailto:tyler.miranda@gmail.com"
    })} />

    <!-- WebSite Schema for Site Search -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Tyler Miranda - Senior Platform Engineer",
      "url": "https://tylermiranda.com",
      "description": "Personal engineering portfolio and field notes of Tyler Miranda, Senior Platform Engineer & AI Systems Builder."
    })} />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
